{
  "name": "ontime-ge",
  "private": true,
  "version": "0.1.0",
  "description": "ontime.ge — restaurant discovery, ordering and reservation platform (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:customer": "npm run dev --workspace=apps/customer",
    "dev:restaurant": "npm run dev --workspace=apps/restaurant",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  }
}
