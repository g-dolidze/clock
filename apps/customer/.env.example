# Where the dev server proxies /v1, /health and /socket.io to.
API_PROXY_TARGET=http://127.0.0.1:3000
PORT=5173

# Stripe publishable key (test mode). Leave unset to use the built-in mock
# checkout flow instead of Stripe Elements.
VITE_STRIPE_PUBLISHABLE_KEY=

# Forces in-browser API mocks instead of hitting a real backend. Vitest
# sets this to true automatically for tests.
VITE_USE_MOCKS=false
